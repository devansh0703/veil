{
  "name": "veil",
  "version": "0.1.0",
  "private": true,
  "description": "Veil — private payment rails for the agent economy. x402 agent payments settled confidentially on Solana via Token-2022 Confidential Balances.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "veil": "packages/cli/src/index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"packages/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test",
    "serve": "node scripts/serve.ts",
    "veil": "node scripts/serve.ts",
    "demo:local": "node scripts/demo-local.ts",
    "pages": "node scripts/build-pages.ts",
    "docs": "node scripts/build-docs.ts",
    "standalone": "node scripts/build-standalone.ts",
    "build:api": "node scripts/build-api.mjs",
    "demo": "npm run demo:local && npm run pages",
    "fund:devnet": "node scripts/fund-devnet.ts",
    "prove:check": "node scripts/prove-check.ts",
    "setup:devnet": "node scripts/setup-devnet.ts",
    "status": "node scripts/status.ts",
    "facilitator": "node scripts/facilitator.ts",
    "go:live": "node scripts/go-live.ts",
    "pay:live": "node scripts/pay-live.ts",
    "pay:rail": "node scripts/pay-rail.ts",
    "pay:agent": "node scripts/veil-fetch.ts",
    "sandbox": "node scripts/sandbox.ts",
    "cli": "node packages/cli/src/index.ts",
    "scaffold": "node scripts/create-merchant.mjs",
    "apply:pending": "node scripts/apply-pending.ts",
    "build:proofs": "node scripts/build-proofs.ts",
    "prove:browser": "node scripts/prove-browser.ts",
    "web": "node scripts/serve-web.ts",
    "check:ui": "node scripts/check-browser-ui.ts",
    "check:refusal": "node scripts/refusal-check.ts"
  },
  "dependencies": {
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana-program/zk-elgamal-proof": "0.4.0",
    "@solana/kit": "8.4.0",
    "@solana/zk-sdk": "0.5.3",
    "@x402/core": "2.28.0",
    "@x402/svm": "2.28.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "esbuild": "^0.28.2",
    "typescript": "5.7.2"
  }
}
