# Veil configuration. Everything here is optional: with none of it set, the
# local server runs against data/pool-ledger.json and reports settlement
# unavailable rather than inventing one. Copy to `.env` and fill in what you use.
#
# `vercel env add` the same names for a hosted rail; a deployment reads them at
# request time, so the values below are the whole difference between the two.

# --- Cluster -----------------------------------------------------------------
# Which chain the rail is on. `solana:testnet`, `solana:devnet`, or `solana:mainnet`.
VEIL_NETWORK=solana:testnet
# The RPC endpoint for that cluster. Required to broadcast; without it the rail
# refuses a paid request with `settlement-unavailable` instead of faking one.
VEIL_RPC_URL=https://api.testnet.solana.com

# --- The merchant's mint and seat keys ---------------------------------------
VEIL_MINT=
VEIL_MINT_CONFIDENTIAL=
VEIL_DECIMALS=6

# --- Durable ledger (optional, and the difference between hosted and demo) ----
# With both set, every instance reads and writes one ledger in Upstash Redis
# over its HTTP REST API, so a seat consumed by one instance is spent for all of
# them and a cold start no longer forgets it. With neither set, the hosted rail
# falls back to a per-instance /tmp copy and /v1/health says `local-file`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- RPC provider (optional) --------------------------------------------------
# Solami serves Solana on **mainnet-beta only** — its cluster route accepts
# `solana` and nothing else, and query params cannot change it. A devnet or
# testnet rail therefore keeps VEIL_RPC_URL above; the key unlocks a mainnet
# deployment without a code change.
SOLAMI_API_KEY=
# Helius serves **devnet and mainnet only** — there is no testnet endpoint
# (the host does not resolve), so a testnet rail keeps VEIL_RPC_URL above.
# With VEIL_RPC_URL unset, the key makes devnet runs use a dedicated node
# instead of the rate-limited public one: option resolution is
# VEIL_RPC_URL → Solami (mainnet) → Helius (devnet/mainnet).
HELIUS_API_KEY=
